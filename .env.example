# Garage Ghost Pro — Lemon Squeezy (all values are PUBLIC and safe for the browser)
# Create a free Lemon Squeezy account, add a "Garage Ghost Pro" product with a
# Monthly ($5.99) and Yearly ($49.99) variant, enable license keys on both, then
# copy the per-variant checkout URLs here. See README.md for the full walkthrough.

# Checkout URL for the monthly variant, e.g. https://yourstore.lemonsqueezy.com/checkout/buy/uuid
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=

# Checkout URL for the yearly variant
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_ANNUAL=

# Your Lemon Squeezy store slug (the "yourstore" part of the checkout URL) — used
# to build the customer billing portal link so Pro users can manage/cancel.
NEXT_PUBLIC_LEMONSQUEEZY_STORE=
